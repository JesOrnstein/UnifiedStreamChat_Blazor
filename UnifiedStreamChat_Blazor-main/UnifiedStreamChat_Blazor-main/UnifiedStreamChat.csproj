<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>462e9370-6eb5-4b4e-8f5b-40a669b4320f</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Google.Protobuf" Version="3.35.1" />
      <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
      <PackageReference Include="Grpc.Tools" Version="2.83.0">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="KickLib" Version="1.13.1" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\stream_list.proto" GrpcServices="Client" />
    </ItemGroup>

</Project>
